#!/bin/bash

if [[ -z ${OLIKUB_PATH:-} ]]; then
  OLIKUB_PATH_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/olikub/path"
  if [[ -r "$OLIKUB_PATH_FILE" ]]; then
    IFS= read -r OLIKUB_PATH < "$OLIKUB_PATH_FILE"
  else
    OLIKUB_PATH=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd -P)
  fi
  export OLIKUB_PATH
fi

source "$OLIKUB_PATH/bin/olikub-sub/header.sh"
source "$OLIKUB_PATH/bin/olikub-sub/menu.sh"
