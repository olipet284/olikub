OLIKUB_PATH_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/olikub/path"
if [[ -r "$OLIKUB_PATH_FILE" ]]; then
    IFS= read -r OLIKUB_PATH < "$OLIKUB_PATH_FILE"
fi
export OLIKUB_PATH="${OLIKUB_PATH:-$HOME/.local/share/olikub}"
source "$OLIKUB_PATH/defaults/bash/rc"
for file in "$HOME"/dotfiles/bash/*; do
    [ -f "$file" ] && source "$file"
done

# Editor used by CLI
export EDITOR="nvim"
export SUDO_EDITOR="$EDITOR"
